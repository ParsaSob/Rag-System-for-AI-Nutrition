{
    "cluster": "market-mine-cluster",
    "serviceName": "market-mine-service",
    "taskDefinition": "market-mine-bot",
    "desiredCount": 1,
    "launchType": "FARGATE",
    "networkConfiguration": {
        "awsvpcConfiguration": {
            "subnets": ["YOUR_SUBNET_ID"],
            "securityGroups": ["YOUR_SECURITY_GROUP_ID"],
            "assignPublicIp": "ENABLED"
        }
    },
    "loadBalancers": [
        {
            "targetGroupArn": "YOUR_TARGET_GROUP_ARN",
            "containerName": "market-mine-bot",
            "containerPort": 8501
        }
    ]
} 